# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.strapi/
.turbo/
out/
coverage/

# Strapi runtime
apps/cms/.tmp/
apps/cms/.cache/
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep
apps/cms/types/generated/

# Next.js
apps/web/next-env.d.ts

