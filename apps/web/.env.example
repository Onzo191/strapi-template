# Server-side Strapi origin (RSC fetches never go through the browser).
# docker-compose sets this to http://cms:1337 on the compose network.
STRAPI_URL=http://localhost:1337

# Public, user-facing site origin (§6.3) — canonical/hreflang/sitemap/JSON-LD
# absolute URLs. NOT the CMS origin. e.g. https://vng.com.vn in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Read-only Content-API token (§9 P7 "add API auth"). REQUIRED unless the CMS is
# running with CMS_PUBLIC_READ=true: the Content API is token-authenticated by
# default, and without this the site renders empty pages.
# Set the SAME value as apps/cms STRAPI_READONLY_API_TOKEN.
STRAPI_API_TOKEN=

# Draft-preview (§6.3): shared secret guarding /api/preview (MUST match apps/cms
# PREVIEW_SECRET) and a Strapi token allowed to read draft content.
# STRAPI_PREVIEW_TOKEN must be a FULL-ACCESS Strapi API token — the CMS draft
# guard (apps/cms/src/middlewares/draft-guard.ts) only lets that type read
# unpublished content, so a read-only token here silently returns published copy.
PREVIEW_SECRET=
STRAPI_PREVIEW_TOKEN=

# CDN in front of S3 media (CloudFront) — allow-listed for next/image and in the
# CSP's img-src/connect-src once wired (§8.1).
CDN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Security headers / CSP (§9 P7 — lib/security-headers.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Origins the `embed` block may put in an <iframe> — the IR / Career / DMF / BU
# properties that stay embedded rather than re-platformed (§0 A7).
# Comma-separated absolute origins. EMPTY ⇒ `frame-src 'none'`, i.e. no embedding
# at all, so an editor cannot frame an arbitrary third-party document.
EMBED_ALLOWED_ORIGINS=

# Ship the CSP as report-only while tuning it against a real page inventory.
# Leave unset (enforcing) in production.
# CSP_REPORT_ONLY=false
# CSP_REPORT_URI=

# HSTS is emitted whenever NODE_ENV=production. Set this only if TLS terminates
# somewhere that makes HSTS wrong (e.g. a shared host on a non-TLS internal leg).
# DISABLE_HSTS=false

# How many trailing X-Forwarded-For hops are OURS (ALB=1, CloudFront+ALB=2).
# The route-handler rate limiter keys on the last trusted hop.
TRUSTED_PROXY_HOPS=1

# Per-instance rate limits for the two Route Handlers (lib/rate-limit.ts).
# REVALIDATE_RATE_LIMIT=120     # requests/min — a second brake behind the HMAC
# PREVIEW_RATE_LIMIT=10         # requests/min — makes secret brute-force useless

# ─────────────────────────────────────────────────────────────────────────────
# ISR cache (§5.3)
# ─────────────────────────────────────────────────────────────────────────────
# Redis for the cache handler — makes revalidateTag cluster-wide.
# docker-compose sets this to redis://redis:6379 on the compose network.
REDIS_URL=redis://localhost:6379
# Optional: namespace + GC ceiling for cached entries (0 = no expiry).
# REDIS_CACHE_PREFIX=vng:next:cache:v1
# REDIS_CACHE_TTL_SECONDS=0

# Shared HMAC secret the CMS signs revalidation webhooks with (§5.3). Signed over
# `<unix-seconds>.<body>`; requests outside a 5-minute window are rejected.
# MUST match apps/cms REVALIDATE_SECRET. Generate: openssl rand -hex 32
REVALIDATE_SECRET=
