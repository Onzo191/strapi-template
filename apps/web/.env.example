# Server-side Strapi origin (RSC fetches never go through the browser).
# docker-compose sets this to http://cms:1337 on the compose network.
STRAPI_URL=http://localhost:1337

# Optional read-only API token, only needed if the CMS's public role doesn't
# allow the read endpoints this app calls.
STRAPI_API_TOKEN=

# CDN in front of S3 media (CloudFront) — allow-listed for next/image once wired (§8.1).
CDN_URL=
