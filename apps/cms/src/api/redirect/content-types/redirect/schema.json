{
  "kind": "collectionType",
  "collectionName": "redirects",
  "info": {
    "singularName": "redirect",
    "pluralName": "redirects",
    "displayName": "Redirect",
    "description": "301 map (from → to) — legacy 404 cleanup (Req §6, §4.1)."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "from": {
      "type": "string",
      "required": true
    },
    "to": {
      "type": "string",
      "required": true
    },
    "permanent": {
      "type": "boolean",
      "default": true
    },
    "statusCode": {
      "type": "integer",
      "default": 301,
      "min": 300,
      "max": 399
    }
  }
}
