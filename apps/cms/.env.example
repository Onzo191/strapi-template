# Strapi server
HOST=0.0.0.0
PORT=1337

# Secrets — generate with: openssl rand -base64 32 (one per key)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database (Postgres 17 via docker-compose)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vng
DATABASE_USERNAME=vng
DATABASE_PASSWORD=vng
DATABASE_SSL=false
