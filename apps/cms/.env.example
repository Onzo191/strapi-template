# Strapi server
HOST=0.0.0.0
PORT=1337

# Secrets — generate with: openssl rand -base64 32 (one per key)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# Database (Postgres 17 via docker-compose)
# NOTE: docker-compose maps Postgres to host port 5433 (container stays 5432).
# Use 5433 when running `strapi develop` on the host against the compose DB.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=vng
DATABASE_USERNAME=vng
DATABASE_PASSWORD=vng
DATABASE_SSL=false

# i18n — default content locale (vi) + secondary (en) are provisioned on
# bootstrap. Set SEED=true to load demo content on first boot (empty DB only).
SEED=true

# ─────────────────────────────────────────────────────────────────────────────
# Content API access (§9 P7 — "add API auth")
# ─────────────────────────────────────────────────────────────────────────────
# The Content API is token-authenticated by DEFAULT. On boot the CMS provisions a
# read-only API token from STRAPI_READONLY_API_TOKEN and REVOKES the public
# role's read permissions. Set the SAME value as apps/web STRAPI_API_TOKEN.
# Generate: openssl rand -hex 32   (minimum 32 chars, or it is refused)
STRAPI_READONLY_API_TOKEN=

# Local-development escape hatch: grant the public role read access so the FE
# works with no token at all. IGNORED when NODE_ENV=production (unless
# CMS_ALLOW_PUBLIC_READ_IN_PROD=true, which you should not need).
CMS_PUBLIC_READ=false

# Content-API query limits (config/api.ts). API_MAX_LIMIT bounds
# ?pagination[pageSize] — the sitemap, our largest legitimate consumer, uses 100.
API_DEFAULT_LIMIT=25
API_MAX_LIMIT=100
# Reject unrecognised query params instead of silently ignoring them.
API_STRICT_PARAMS=true

# ─────────────────────────────────────────────────────────────────────────────
# Admin session timeout (§9 P7 — config/admin.ts). All values in seconds.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SESSION_ACCESS_TOKEN_SECONDS=900      # 15 min — stolen-token window
ADMIN_SESSION_IDLE_SECONDS=1800             # 30 min — unattended laptop
ADMIN_SESSION_MAX_SECONDS=28800             # 8 h — one working day
ADMIN_REFRESH_IDLE_SECONDS=1800             # 30 min — "remember me" idle cap
ADMIN_REFRESH_MAX_SECONDS=28800             # 8 h — "remember me" absolute cap
# Leave unset to derive from NODE_ENV (true in production). Must be false over
# plain http, or admin login cannot complete.
# ADMIN_COOKIE_SECURE=

# Strapi telemetry and the marketplace/NPS widgets call third-party origins that
# the tightened admin CSP no longer allows.
STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (§9 P7 — src/middlewares/rate-limit.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Redis-backed so limits are CLUSTER-WIDE (per-instance counters would give an
# attacker limit × instances login attempts). Without REDIS_URL the limiter is
# INACTIVE and logs a warning — set it before production.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10                          # credential submission / 5 min
RATE_LIMIT_AUTH_WINDOW=300
RATE_LIMIT_SSO=60                           # OIDC redirects / 5 min (NAT-tolerant)
RATE_LIMIT_SSO_WINDOW=300
RATE_LIMIT_WRITE=120                        # writes + uploads / min
RATE_LIMIT_WRITE_WINDOW=60
RATE_LIMIT_READ=600                         # reads / min
RATE_LIMIT_READ_WINDOW=60
# How many trailing X-Forwarded-For hops are OURS (ALB=1, CloudFront+ALB=2). The
# limiter keys on the last trusted hop, which a client cannot forge away.
TRUSTED_PROXY_HOPS=1

# Request body caps (config/middlewares.ts). Strapi's defaults are ~200mb.
BODY_JSON_LIMIT=1mb
BODY_FORM_LIMIT=1mb
BODY_TEXT_LIMIT=1mb
UPLOAD_MAX_FILE_SIZE_BYTES=52428800         # 50 MB

# CORS + admin-CSP allow-list. Comma-separated absolute origins.
WEB_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Admin SSO via OIDC (Req §8, §0 A3 — src/plugins/sso)
# ─────────────────────────────────────────────────────────────────────────────
# Leave OIDC_ISSUER empty to disable SSO entirely (local password login only).
# OIDC_REDIRECT_URI must match the IdP client registration EXACTLY.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:1337/api/sso/callback
OIDC_SCOPES=openid profile email

# Redirect every session-less admin page load into the IdP, so the local password
# form is break-glass only (reachable with ?sso=off, which logs a WARN).
OIDC_ENFORCE=false

# MFA assurance (Req §8). ON by default: the ID token must carry a matching
# `acr` or `amr` claim, otherwise the login is refused.
OIDC_REQUIRE_MFA=true
# OIDC_MFA_ACR_VALUES=mfa,urn:vng:acr:mfa
# OIDC_MFA_AMR_VALUES=mfa,otp,fido,hwk
# Ask the IdP to step up, rather than only checking after the fact.
# OIDC_ACR_VALUES=mfa

# Account provisioning. OFF by default: the admin user must already exist, so SSO
# authenticates but never grants access. Turn it on only WITH a domain
# allow-list, or any identity the IdP will mint a token for gets a CMS account.
OIDC_AUTO_PROVISION=false
OIDC_ALLOWED_EMAIL_DOMAINS=vng.com.vn
# The email claim is the account-identity key, so an unverified address is an
# account-takeover primitive. Only set false for an IdP that verifies addresses out
# of band and omits the claim. Note `preferred_username` is never used as a fallback.
OIDC_REQUIRE_EMAIL_VERIFIED=true
# IdP group → admin role code. `strapi-super-admin` is never assignable here.
# OIDC_ROLE_MAP=VNG-CMS-Admins:vng-admin,VNG-CMS-Editors:vng-editor,VNG-CMS-Writers:vng-contributor
OIDC_GROUPS_CLAIM=groups
# Role for an authenticated user whose groups match nothing. Unset ⇒ no access.
# OIDC_DEFAULT_ROLE=vng-viewer

# ─────────────────────────────────────────────────────────────────────────────
# Upload virus scanning (Req §2, §0 A6 — src/upload/virus-scan.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Mode A — inline: scan BEFORE the object reaches S3, via a `clamd` sidecar.
# Unset ⇒ inline scanning is off.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Fail CLOSED by default: an unreachable scanner rejects the upload rather than
# storing an unscanned file.
UPLOAD_SCAN_FAIL_OPEN=false

# Mode B — async: S3 ObjectCreated → Lambda/ClamAV → signed callback to
# POST /api/upload-scan/callback. Must match the Lambda's copy of the secret.
# Generate: openssl rand -hex 32
UPLOAD_SCAN_CALLBACK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Revalidation webhook (§5.3)
# ─────────────────────────────────────────────────────────────────────────────
# Where to POST content-change notifications, and the shared HMAC secret used to
# sign them (over `<unix-seconds>.<body>`, with a 5-minute replay window).
# REVALIDATE_SECRET MUST match apps/web REVALIDATE_SECRET. Leave
# WEB_REVALIDATE_URL empty to disable the webhook (the FE then relies on
# time-based revalidation only).
# docker-compose sets WEB_REVALIDATE_URL to http://web:3000/api/revalidate.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Draft preview (§6.3) — the admin "Preview" button opens the FE draft-mode
# route. WEB_PREVIEW_URL is the public web origin; PREVIEW_SECRET MUST match
# apps/web PREVIEW_SECRET. Leave either empty to disable preview.
WEB_PREVIEW_URL=http://localhost:3000
PREVIEW_SECRET=

# Media / S3 upload provider (§4.6 — config only; real bucket wired later).
# Leave AWS_BUCKET empty to use the local upload provider (dev/CI default).
AWS_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_ACL=private
AWS_ROOT_PATH=
AWS_SIGNED_URL_EXPIRES=900
# CDN in front of the bucket (CloudFront) — used as the public media base URL.
CDN_URL=
