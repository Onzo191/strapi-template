{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "extends": ["@vng/config-biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/.strapi",
      "!**/.turbo",
      "!**/coverage",
      "!**/node_modules",
      "!apps/cms/types/generated",
      "!docs",
      "!**/*.md"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "css": { "parser": { "tailwindDirectives": true } }
    }
  ]
}
